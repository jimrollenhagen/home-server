<domain type='kvm'>
  <name>plex</name>
  <uuid>d201c3c5-5dc6-4b76-861f-3b8f7b901245</uuid>
  <description>Plex Media Server — VLAN 20 (apps), 10.20.0.20</description>
  <memory unit='GiB'>8</memory>
  <currentMemory unit='GiB'>8</currentMemory>
  <vcpu placement='static'>4</vcpu>

  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <boot dev='hd'/>
  </os>
  <features>
    <acpi/>
    <apic/>
  </features>
  <cpu mode='host-passthrough' check='none'/>
  <clock offset='utc'/>

  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>restart</on_crash>

  <!-- Required for virtiofs: shared memory backing. Without it the domain
       refuses to start with an error that never mentions virtiofs. -->
  <memoryBacking>
    <source type='memfd'/>
    <access mode='shared'/>
  </memoryBacking>

  <devices>
    <disk type='block' device='disk'>
      <driver name='qemu' type='raw' cache='none' io='native'/>
      <source dev='/dev/zvol/ark/vm/plex-os'/>
      <target dev='vda' bus='virtio'/>
    </disk>

    <disk type='block' device='disk'>
      <driver name='qemu' type='raw' cache='none' io='native'/>
      <source dev='/dev/zvol/ark/vm/plex-config'/>
      <target dev='vdb' bus='virtio'/>
    </disk>

    <interface type='bridge'>
      <mac address='52:54:00:00:20:20'/>
      <source bridge='br20'/>
      <model type='virtio'/>
    </interface>

    <!-- The existing library on the host, read-only, mounted in the guest at /media.
         No volume, no copy: virtiofs exports the directory as-is. -->
    <filesystem type='mount' accessmode='passthrough'>
      <driver type='virtiofs'/>
      <source dir='/srv/ark/ephemeral/media/media'/>
      <target dir='media'/>
    </filesystem>

    <serial type='pty'>
      <target port='0'/>
    </serial>
    <console type='pty'>
      <target type='serial' port='0'/>
    </console>

    <channel type='unix'>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
    </channel>

    <graphics type='vnc' port='-1' autoport='yes' listen='127.0.0.1'/>
    <video>
      <model type='vga'/>
    </video>

    <memballoon model='virtio'/>
  </devices>
</domain>
